{
  "name": "holdem-e2e",
  "private": true,
  "type": "module",
  "description": "Vite版・Expo版の画面の通し確認（Playwright）。容量の大きいフォントを使うので、アプリ本体の workspaces には入れていない",
  "scripts": {
    "setup": "npm install && playwright install chromium",
    "test": "playwright test",
    "test:vite": "playwright test --project=vite",
    "test:expo": "playwright test --project=expo",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "i18next": "^26.7.1",
    "typescript": "~6.0"
  }
}
