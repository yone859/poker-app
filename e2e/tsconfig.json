{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    // 画面の操作を書いた部分は、引数の型を書かなくてよいことにする（Playwright が実行時に型を外して動かす）
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["tests", "playwright.config.ts"]
}
