{
  "expo": {
    "name": "Hold'em Chip Tracker",
    "slug": "holdem-chip-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d1511",
    "locales": {
      "ja": "./languages/ja.json",
      "en": "./languages/en.json",
      "zh-Hans": "./languages/zh-Hans.json",
      "zh-Hant": "./languages/zh-Hant.json",
      "ko": "./languages/ko.json",
      "es": "./languages/es.json",
      "pt": "./languages/pt.json",
      "fr": "./languages/fr.json",
      "de": "./languages/de.json",
      "it": "./languages/it.json",
      "ru": "./languages/ru.json",
      "vi": "./languages/vi.json"
    },
    "ios": {
      "bundleIdentifier": "com.yone859.holdemchiptracker",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.yone859.holdemchiptracker",
      "adaptiveIcon": {
        "backgroundColor": "#0d1511",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "ja",
              "en",
              "zh-Hans",
              "zh-Hant",
              "ko",
              "es",
              "pt-BR",
              "fr",
              "de",
              "it",
              "ru",
              "vi"
            ],
            "android": [
              "ja",
              "en",
              "zh-Hans",
              "zh-Hant",
              "ko",
              "es",
              "pt-BR",
              "fr",
              "de",
              "it",
              "ru",
              "vi"
            ]
          }
        }
      ],
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d1511",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ]
  }
}
