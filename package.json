{
  "name": "poker-app",
  "private": true,
  "workspaces": [
    "shared",
    "web",
    "expo-app"
  ],
  "scripts": {
    "test": "npm run test -w shared",
    "e2e:setup": "npm --prefix e2e run setup",
    "test:e2e": "npm --prefix e2e test --",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "lint": "npm run lint -w shared && npm run lint -w web && npm run lint -w expo-app",
    "start:app": "npm run start -w expo-app --",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w expo-app"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
